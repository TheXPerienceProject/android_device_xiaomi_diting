cc_library_shared {
    name: "libcodec2_hidl_shim",
    srcs: ["libcodec2_hidl_shim.cpp"],
    shared_libs: [
        "libcodec2_hidl@1.0",
    ],
    vendor_available: true,
}

cc_library_shared {
    name: "libqti_c2_store_abi_check",
    vendor: true,
    compile_multilib: "64",
    defaults: ["libcodec2-hidl-defaults@1.0"],
        shared_libs: ["libcodec2_hidl@1.2"],
        srcs: [
            "c2_store_abi_check/abi_check_1_0.cpp",
            "c2_store_abi_check/abi_check_1_2.cpp",
        ],
}
