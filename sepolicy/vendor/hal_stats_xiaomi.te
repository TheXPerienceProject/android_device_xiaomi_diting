# Domain for Xiaomi Power Stats AIDL Service
type hal_power_stats_xiaomi, domain;
type hal_power_stats_xiaomi_exec, exec_type, vendor_file_type, file_type;

# Initialize as daemon domain
init_daemon_domain(hal_power_stats_xiaomi)

# Allow basic process operations
allow hal_power_stats_xiaomi self:process { fork sigchld };
allow hal_power_stats_xiaomi self:capability { sys_nice };
allow hal_power_stats_xiaomi self:fd use;

# Allow execution of own binary
allow hal_power_stats_xiaomi hal_power_stats_xiaomi_exec:file { 
    execute read open getattr 
};

# ========== GENÉRIC PERMISSIONS ==========
# Acceso a /proc para estadísticas del sistema
allow hal_power_stats_xiaomi proc:dir { search getattr };
allow hal_power_stats_xiaomi proc:file { read open getattr };

# Acceso a /sys para hardware monitoring
allow hal_power_stats_xiaomi sysfs:dir { search getattr };
allow hal_power_stats_xiaomi sysfs:file { read open getattr };

# Acceso a dispositivos de caracteres genéricos
allow hal_power_stats_xiaomi device:chr_file { read open getattr };

# ========== BINDER COMMUNICATION ==========
allow hal_power_stats_xiaomi servicemanager:binder { call transfer };
binder_use(hal_power_stats_xiaomi)
binder_service(hal_power_stats_xiaomi)

# Allow to be found by servicemanager
allow hal_power_stats_xiaomi service_manager_type:service_manager find;

# ========== LOGGING PERMISSIONS ==========
allow hal_power_stats_xiaomi logd_socket:sock_file { write };

# ========== SYSTEM PROPERTIES ==========
allow hal_power_stats_xiaomi system_prop:property_service { set };
get_prop(hal_power_stats_xiaomi, system_prop)
get_prop(hal_power_stats_xiaomi, vendor_default_prop)

# ========== VENDOR PROPERTIES ==========
allow hal_power_stats_xiaomi vendor_sysfs_battery_supply:dir r_dir_perms;
allow hal_power_stats_xiaomi vendor_sysfs_battery_supply:file r_file_perms;
allow hal_power_stats_xiaomi vendor_sysfs_kgsl_gpuclk:file r_file_perms;
allow hal_power_stats_xiaomi vendor_sysfs_kgsl:file r_file_perms;
